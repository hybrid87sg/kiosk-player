<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To learn this TV's own network address, so it can look for the server. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Display over other apps": lets the player bring itself back to the front
         and start reliably on boot (see KeepInFront.kt). Granted by the user. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- To switch the screen back on at opening time (see AfterHours.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Runs as a media app, so Android doesn't close it to free memory (see KeepAliveService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Updates from the dashboard: "Install unknown apps", granted once by the user (see AppUpdater.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- An Android TV app: no touch screen needed, and it shows up on the TV home screen. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".KioskPlayerApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KioskPlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional: the player as the TV box's home screen (see HomeScreen.kt). Off until turned on. -->
        <activity-alias
            android:name=".HomeScreen"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps the player counted as a media app (see KeepAliveService.kt). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Reopens the player if it was closed (see Watchdog.kt). -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

        <!-- "Allow Kiosk Player to turn the screen off": for after hours (AfterHours.kt). -->
        <receiver
            android:name=".ScreenOffAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/screen_off_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Wakes the screen at opening time. -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="false" />

        <!-- App updates: the installer's answer, and reopening after the update (see AppUpdater.kt). -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".AppReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Opens the player when the TV box is switched on. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
